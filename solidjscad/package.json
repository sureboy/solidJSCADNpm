{
	"name": "solidjscad",
	"version": "0.0.1",
	"bin": {
		"solidjscad": "./run.js"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"build",
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"publint": "^0.3.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"keywords": [
		"svelte"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.1",
		"@types/three": "^0.186.0",
		"cors": "^2.8.6",
		"error-stack-parser": "^2.1.4",
		"es-module-lexer": "^3.0.4",
		"express": "^5.3.0",
		"fast-diff": "^1.3.0",
		"modern-tar": "^0.8.5",
		"qrcode": "^1.5.4",
		"three": "^0.186.1",
		"three-3mf-exporter": "^45.2.0",
		"yjs": "^13.6.33"
	}
}
